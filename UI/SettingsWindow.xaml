                              Fill="{DynamicResource AccentBrush}" Stretch="Uniform" Width="16" Height="16"/>
                    </Button>
                    <CheckBox Grid.Column="3"
                              x:Name="CopyTripleClickCheckBox"
                              Content="Triple Click"
                              Style="{StaticResource DarkCheckBoxStyle}"
                              Margin="8,0,0,0"
                              VerticalAlignment="Center"/>
                </Grid>
                
                <!-- Save Hotkey -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" 
                               Text="Save:" 
                               Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" 
                             x:Name="SaveHotkeyTextBox"
                             Style="{StaticResource DarkTextBoxStyle}"
                             MinWidth="120" Width="200"
                             Text=""
                             IsReadOnly="True"
                             PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"
                             GotFocus="HotkeyTextBox_GotFocus"
                             LostFocus="HotkeyTextBox_LostFocus"/>
                    <Button Grid.Column="2" x:Name="SaveClearHotkeyButton" Width="28" Height="28" Margin="4,0,0,0"
                            ToolTip="Remove hotkey" Click="ClearHotkeyButton_Click" Tag="Save"
                            Style="{StaticResource ModernButtonStyle}" Padding="0" VerticalAlignment="Center"
                            BorderThickness="0" BorderBrush="Transparent" Background="Transparent">
                        <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" 
                              Fill="{DynamicResource AccentBrush}" Stretch="Uniform" Width="16" Height="16"/>
                    </Button>
                    <CheckBox Grid.Column="3"
                              x:Name="SaveTripleClickCheckBox"
                              Content="Triple Click"
                              Style="{StaticResource DarkCheckBoxStyle}"
                              Margin="8,0,0,0"
                              VerticalAlignment="Center"/>
                </Grid>
                        </StackPanel>

                        <StackPanel x:Name="UpdatesSection" Visibility="Collapsed">
                            <TextBlock Text="Updates" Style="{StaticResource SettingsCategoryTitleStyle}"/>
                <CheckBox x:Name="EnableAutoUpdateCheckBox" 
                          Content="Automatically check for updates"
                          Style="{StaticResource DarkCheckBoxStyle}"
                          Margin="0,0,0,10"/>
                
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" 
                               Text="Check for updates manually:" 
                               Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1" 
                            x:Name="CheckForUpdatesButton"
                            Style="{StaticResource ModernButtonStyle}"
                            MinWidth="100"
                            Height="36"
                            Padding="14,6"
                            Click="CheckForUpdatesButton_Click">
                        <TextBlock Text="Check Now" 
                                   Foreground="#FFFF8C00" 
                                   FontSize="14" 
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Button>
                </Grid>
                
                <TextBlock Name="UpdateStatusText"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="11"
                           Margin="0,5,0,15"
                           Visibility="Collapsed"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,16,0,-18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Button x:Name="ResetRecommendedDefaultsButton"
                        Style="{StaticResource ModernButtonStyle}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Height="36"
                        MinWidth="200"
                        Padding="18,0"
                        Click="ResetRecommendedDefaultsButton_Click"
                        ToolTip="Restore settings and hotkeys to the recommended profile. Click Save to keep changes.">
                    <TextBlock Text="Reset to recommended defaults"
                               Foreground="#FFFF8C00"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextWrapping="NoWrap"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Button>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Style="{StaticResource ModernButtonStyle}" Click="CancelButton_Click"
                        Margin="0,0,12,0" MinWidth="100" Height="36" Padding="18,0">
                    <TextBlock Text="Cancel" Foreground="#FFFF8C00" FontSize="14" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button x:Name="SaveButton" Style="{StaticResource ModernButtonStyle}" Click="SaveButton_Click"
                        MinWidth="100" Height="36" Padding="18,0">
                    <TextBlock Text="Save" Foreground="#FFFF8C00" FontSize="14" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,15,0">
                <TextBlock x:Name="PrivacyLinkText" Text="Privacy"
                           Foreground="{DynamicResource AccentBrush}"
                           FontSize="11"
                           Opacity="0.85"
                           VerticalAlignment="Center"
                           Cursor="Hand"
                           MouseLeftButtonDown="PrivacyLink_MouseLeftButtonDown"/>
                <TextBlock Text=" | " Foreground="{StaticResource TextBrush}" FontSize="11" Opacity="0.6" VerticalAlignment="Center" Margin="4,0"/>
                <TextBlock x:Name="VersionTextBlock" Text="" Foreground="{StaticResource TextBrush}" FontSize="11" Opacity="0.6" VerticalAlignment="Center"/>
                <TextBlock Text=" | " Foreground="{StaticResource TextBrush}" FontSize="11" Opacity="0.6" VerticalAlignment="Center" Margin="4,0"/>
                <TextBlock Text="Created by: BMOandShiro" Foreground="{StaticResource TextBrush}" FontSize="11" Opacity="0.6" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
