<Window x:Class="SharpShot.UI.AppLinkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Link Application"
        Width="520"
        Height="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="AppLinkListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{DynamicResource AccentColor}" Opacity="0.19"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{DynamicResource AccentColor}" Opacity="0.08"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border CornerRadius="10" Background="#FF1E1E1E" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Padding="0">
        <Border.Effect>
            <DropShadowEffect Color="Black" Direction="315" ShadowDepth="5" BlurRadius="12" Opacity="0.55"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#FF2D2D2D" CornerRadius="10,10,0,0" Padding="14,12"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,0,0,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TitleTextBlock" Grid.Column="0"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center"
                               Text="Link Application"/>
                    <Button x:Name="CloseButton" Grid.Column="1" Width="30" Height="30"
                            VerticalAlignment="Top" Click="CloseButton_Click" ToolTip="Cancel">
                        <TextBlock Text="✕" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <TextBlock x:Name="MessageTextBlock" Grid.Row="1"
                       Margin="18,12,18,8"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="13"
                       LineHeight="20"
                       Text="Select an installed application or browse for an executable."/>

            <ListBox x:Name="AppsListBox" Grid.Row="2"
                     Margin="18,0,18,8"
                     Background="#FF2A2A2A"
                     Foreground="{StaticResource TextBrush}"
                     BorderBrush="{DynamicResource AccentBrush}"
                     BorderThickness="1"
                     DisplayMemberPath="DisplayName"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ItemContainerStyle="{StaticResource AppLinkListItemStyle}"
                     SelectionChanged="AppsListBox_SelectionChanged">
                <ListBox.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ThemedScrollBarStyle}"/>
                </ListBox.Resources>
            </ListBox>

            <TextBlock x:Name="SelectedPathTextBlock" Grid.Row="3"
                       Margin="18,0,18,8"
                       TextWrapping="Wrap"
                       FontSize="11"
                       Foreground="#FF888888"
                       Text="No application selected"/>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="12,8,14,14">
                <Button x:Name="BrowseButton" Click="BrowseButton_Click" Margin="0,0,10,0">
                    <TextBlock Text="Browse…" FontSize="13" FontWeight="SemiBold"/>
                </Button>
                <Button x:Name="CancelButton" Click="CancelButton_Click" Margin="0,0,10,0">
                    <TextBlock Text="Cancel" FontSize="13" FontWeight="SemiBold"/>
                </Button>
                <Button x:Name="LinkButton" Click="LinkButton_Click" IsEnabled="False">
                    <TextBlock Text="Link" FontSize="13" FontWeight="SemiBold"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
