<Window x:Class="SharpShot.UI.PrivacyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Privacy policy"
        Height="560"
        Width="640"
        MinHeight="360"
        MinWidth="480"
        Style="{StaticResource DarkWindowStyle}"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Privacy policy"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}"
                       VerticalAlignment="Center"/>
            <Button HorizontalAlignment="Right"
                    Style="{StaticResource ToolbarButtonStyle}"
                    Width="38"
                    Height="38"
                    Padding="6"
                    Click="CloseButton_Click"
                    Cursor="Hand">
                <Path Data="M1 1L11 11M11 1L1 11"
                      Stroke="{DynamicResource AccentBrush}"
                      StrokeThickness="2"
                      Fill="Transparent"
                      Stretch="Uniform"
                      Width="22"
                      Height="22"/>
            </Button>
        </Grid>

        <Border Grid.Row="1"
                Background="#FF1A1A1A"
                CornerRadius="8"
                Padding="12"
                BorderBrush="#FF404040"
                BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ThemedScrollBarStyle}"/>
                </ScrollViewer.Resources>
                <TextBox x:Name="PolicyText"
                         Style="{StaticResource DarkTextBoxStyle}"
                         Background="Transparent"
                         BorderThickness="0"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         IsTabStop="False"
                         FontSize="13"
                         Foreground="{StaticResource TextBrush}"/>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="2"
                   Margin="0,12,0,0"
                   Text="The live copy is on GitHub. Paste that page into Steam and the Microsoft Store."
                   Foreground="{StaticResource TextBrush}"
                   Opacity="0.65"
                   FontSize="11"
                   TextWrapping="Wrap"/>
    </Grid>
</Window>
