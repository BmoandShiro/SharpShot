<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
    Id="*"
    Name="SharpShot"
    Language="1033"
    Version="1.3.1.9"
    Manufacturer="BmoandShiro"
    UpgradeCode="F3D9B9B4-7F4D-4C5B-9D32-8F6E4C8D9A11">

    <Package
      InstallerVersion="500"
      Compressed="yes"
      InstallScope="perMachine"
      Platform="x64" />

    <MajorUpgrade
      DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <MediaTemplate />

    <Icon Id="SharpShotIcon.ico" SourceFile="..\output_color.ico" />
    <Property Id="ARPPRODUCTICON" Value="SharpShotIcon.ico" />

    <WixVariable Id="WixUILicenseRtf" Value="Installer\License.rtf" />
    <UIRef Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="SharpShot" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="SharpShot" />
      </Directory>
    </Directory>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcut" Guid="A7C3E91D-2F4B-4E8A-9C1D-5B6E8F0A2C44">
        <Shortcut
          Id="ApplicationStartMenuShortcut"
          Name="SharpShot"
          Description="Screenshot and screen recording tool"
          Target="[INSTALLDIR]SharpShot.exe"
          WorkingDirectory="INSTALLDIR"
          Icon="SharpShotIcon.ico" />
        <RemoveFolder Id="CleanUpStartMenuFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue
          Root="HKCU"
          Key="Software\BmoandShiro\SharpShot"
          Name="StartMenuShortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature
      Id="MainFeature"
      Title="SharpShot"
      Level="1">
      <ComponentGroupRef Id="SharpShotComponents" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Product>
</Wix>
